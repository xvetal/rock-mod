{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "importHelpers": true,
    "moduleResolution": "node",
    "outDir": "../../dist/client",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@RockMod/client/*": ["./*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "references": [{ "path": "../shared" }],
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules"]
}
